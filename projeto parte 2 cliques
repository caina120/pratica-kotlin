 DisciplinasActivity : AppCompatActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_disciplinas)

        // Reclassferenciando os botões da tela
        val btnProgramacao = findViewById<Button>(R.id.btnProgramacao)
        val btnWeb = findViewById<Button>(R.id.btnWeb)
        val btnMobile = findViewById<Button>(R.id.btnMobile)
        val btnIA = findViewById<Button>(R.id.btnIA)
        val btnEngSoftware = findViewById<Button>(R.id.btnEngSoftware)

        // Evento para Programação
        btnProgramacao.setOnClickListener {
            abrirDetalhes(
                nome = "Programação",
                carga = "60 horas",
                modalidade = "Presencial",
                nivel = "Iniciante",
                professor = "Prof. Ana Souza",
                descricao = "Estudo dos fundamentos de lógica de programação, algoritmos e estruturas de controle."
            )
        }

        // Evento para Desenvolvimento Web
        btnWeb.setOnClickListener {
            abrirDetalhes(
                nome = "Desenvolvimento Web",
                carga = "80 horas",
                modalidade = "Híbrido",
                nivel = "Intermediário",
                professor = "Prof. Carlos Lima",
                descricao = "Desenvolvimento de páginas e sistemas web utilizando HTML, CSS, JavaScript e frameworks modernos."
            )
        }

        // Evento para Desenvolvimento Mobile
        btnMobile.setOnClickListener {
            abrirDetalhes(
                nome = "Desenvolvimento Mobile",
                carga = "80 horas",
                modalidade = "Presencial",
                nivel = "Intermediário",
                professor = "Prof. Leandro Melo",
                descricao = "Nesta disciplina são estudados conceitos relacionados ao desenvolvimento de aplicativos nativos e multiplataforma."
            )
        }

        // Evento para Inteligência Artificial
        btnIA.setOnClickListener {
            abrirDetalhes(
                nome = "Inteligência Artificial",
                carga = "60 horas",
                modalidade = "Online",
                nivel = "Avançado",
                professor = "Profª. Beatriz Costa",
                descricao = "Introdução aos conceitos de Machine Learning, redes neurais e processamento de linguagem natural."
            )
        }

        // Evento para Engenharia de Software
        btnEngSoftware.setOnClickListener {
            abrirDetalhes(
                nome = "Engenharia de Software",
                carga = "60 horas",
                modalidade = "Presencial",
                nivel = "Intermediário",
                professor = "Prof. Roberto Dias",
                descricao = "Processos de desenvolvimento de software, metodologias ágeis, testes e qualidade de código."
            )
        }
    }

    // Função auxiliar para evitar repetição de código ao criar o Intent
    private fun abrirDetalhes(nome: String, carga: String, modalidade: String, nivel: String, professor: String, descricao: String) {
        val intent = Intent(this, DetalhesDisciplinaActivity::class.java).apply {
            putExtra("EXTRA_NOME", nome)
            putExtra("EXTRA_CARGA", carga)
            putExtra("EXTRA_MODALIDADE", modalidade)
            putExtra("EXTRA_NIVEL", nivel)
            putExtra("EXTRA_PROFESSOR", professor)
            putExtra("EXTRA_DESCRICAO", descricao)
        }
        startActivity(intent)
    }
